<?xml version="1.0" encoding="utf-8"?>
<!--
  Financial data must never leave the phone through Android's own backup or device-to-device transfer.
  People move their data with the app's password-protected backup instead (Settings -> Back up everything).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
